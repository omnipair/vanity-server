# Vanity Server Configuration
# Copy this file to .env and modify as needed

# Server port (default: 8080)
VANITY_PORT=8080

# Default grinding parameters (optional)
# NOTE: Base pubkey must be provided as a query parameter in API requests
# Example: /grind?base=3tJrAXnjofAw8oskbMaSo9oMAYuzdBgVbW3TvQLdMEBd

# Default owner pubkey for grinding (defaults to SPL Token)
VANITY_DEFAULT_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# Optional Base58 prefix. Prefix + requested suffix must total at most 4 chars.
# VANITY_DEFAULT_PREFIX=

# Default case sensitivity (true/false)
# VANITY_DEFAULT_CASE_INSENSITIVE=false

# Task time budget in seconds (default: 30; accepted range: 1..300).
# Enforced inside the CPU worker as well as the HTTP handler.
# VANITY_TASK_TIMEOUT=30

# Maximum active grinding tasks per instance (default: 1; range: 1..64).
# Each task uses one CPU worker. Excess requests receive 429, without queueing.
# Size this to the CPU allocation of the service.
# VANITY_MAX_CONCURRENT_TASKS=1

# Global token bucket per instance: refill rate per minute and initial/max burst
# (default: 60; accepted range: 1..10000). Applies only to admitted grind jobs.
# VANITY_MAX_REQUESTS_PER_MINUTE=60

# CORS allowed origins (comma-separated)
# VANITY_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
